---
import type { LogoWallBlock } from '@repo/shared'
import Picture from '@/components/ui/Picture.astro'

interface Props {
  block: LogoWallBlock
}

const { block } = Astro.props

const headingId = 'logo-wall-heading'

/**
 * Reveal order. The two halves of the heading are separate steps because they are
 * two separate claims — the accent half landing a beat after the neutral one is
 * the whole point of splitting the colour. Logos then arrive at half steps, so the
 * row assembles left to right in ~450 ms instead of dragging on for a second.
 */
const order = {
  heading: 0,
  headingAccent: 1,
  lead: 2,
  logos: 3,
  logoStep: 0.5,
}

/*
 * Three identical groups, not two. The loop's period is one group plus one gap
 * (see the keyframe), and that period — six marks at ~821 px plus 64 — is
 * narrower than the 1360 px inner container. Two groups would leave a hole at the
 * right edge halfway through the cycle; three cover the container at every offset.
 */
const marqueeGroups = [false, true, true]
---

<section class="logo-wall" aria-labelledby={headingId} data-reveal-group>
  <div class="container-page">
    {
      /*
        One <h2>, two masked runs. `inline-block` rather than the block-level mask
        the hero uses: here the break between the halves is not designed, the two
        clauses share a line at every width that fits them, and only a viewport too
        narrow for both moves the accent onto its own line.
      */
    }
    <h2 class="logo-wall__heading text-heading" id={headingId}>
      <span class="reveal-mask" style={`--reveal-index: ${order.heading}`}>
        <span>{block.heading}</span>
      </span>{' '}
      {
        block.headingAccent && (
          <span
            class="reveal-mask logo-wall__accent"
            style={`--reveal-index: ${order.headingAccent}`}
          >
            <span>{block.headingAccent}</span>
          </span>
        )
      }
    </h2>

    {
      block.subheading && (
        <p class="logo-wall__lead text-body reveal" style={`--reveal-index: ${order.lead}`}>
          {block.subheading}
        </p>
      )
    }

    <div class="logo-wall__marquee">
      <div class="logo-wall__track">
        {
          marqueeGroups.map((isDuplicate) => (
            <ul
              class="logo-wall__list"
              role="list"
              aria-hidden={isDuplicate ? 'true' : undefined}
            >
              {block.logos.map((logo, index) => (
                <li
                  class="logo-wall__item reveal"
                  style={`--reveal-index: ${order.logos + index * order.logoStep}; --logo-native-width: ${logo.width}px`}
                >
                  <Picture
                    image={logo}
                    widths={[logo.width]}
                    sizes={`${Math.round(logo.width)}px`}
                    fallbackFormat="png"
                  />
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .logo-wall {
    padding-block: var(--space-14);
    background-color: var(--color-bg);
  }

  .logo-wall__heading {
    color: var(--color-fg);
    /* The mask clips to the run's own box; without this the accent half sits on
       the heading's baseline but its descenders would push the line box down. */
    text-wrap: balance;
  }

  .logo-wall__accent {
    color: var(--color-fg-accent);
  }

  /* `.reveal-mask` is a block by default — the two runs of the heading share a line. */
  .logo-wall__heading .reveal-mask {
    display: inline-block;
    vertical-align: top;
  }

  .logo-wall__lead {
    margin-block-start: var(--space-4);
    /*
     * 0.65, not the 0.6 the design specifies. At 0.6 this copy measures 4.04:1 on
     * white and 16 px regular text needs 4.5:1 (WCAG 1.4.3); 0.65 puts it at
     * 4.70:1, which is the smallest step off the design that passes. Same token as
     * every other muted body line on a light surface — see DECISIONS.md.
     */
    color: var(--color-fg-muted);
    /*
     * The design sets this on one line, 454 px wide, and the copy is a placeholder
     * that stops mid-sentence. The measure is what keeps the real sentence, when it
     * arrives, from running the width of the page.
     */
    max-inline-size: 32rem;
  }

  .logo-wall__marquee {
    overflow: hidden;
    margin-block-start: var(--space-12);
  }

  .logo-wall__track {
    display: flex;
    inline-size: max-content;
    will-change: transform;
    animation: logo-wall-marquee var(--logo-marquee-duration) linear infinite;
  }

  .logo-wall__list {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--logo-marquee-gap);
    inline-size: max-content;
    list-style: none;
    /*
     * The trailing gap belongs to the group, not to the track. A gap on the track
     * would sit between groups but not after the last one, so the loop's period and
     * the track's width would disagree; as padding it makes every group exactly one
     * period wide and the seam gap identical to the five inside it.
     */
    padding: 0 var(--logo-marquee-gap) 0 0;
  }

  .logo-wall__item {
    flex: none;
    /*
     * Every mark is exported from the same frame at the same scale, so one factor
     * reproduces the relative sizing the designer set between them. `--logo-scale`
     * carries the reasoning; `--logo-native-width` comes from the fixture, which is
     * the only place the real pixel dimensions of a given file belong.
     */
    inline-size: calc(var(--logo-native-width) * var(--logo-scale));
    max-inline-size: 100%;
  }

  .logo-wall__item :global(img) {
    inline-size: 100%;
    /* The intrinsic ratio does the rest — width/height are on the tag, so nothing
       reflows when the file lands. */
    block-size: auto;
  }

  /*
   * One period is one group including its trailing gap, i.e. a third of the track.
   * The group that lands where the first one started is identical to it, so the
   * loop has no jump — and because the marks no longer stretch to fill the
   * container, every gap in the row is the same one.
   */
  @keyframes logo-wall-marquee {
    to {
      transform: translateX(calc(-100% / 3));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-wall__marquee {
      overflow: visible;
    }

    .logo-wall__track {
      display: block;
      inline-size: 100%;
      will-change: auto;
      animation-name: none !important;
      transform: none;
    }

    .logo-wall__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-items: center;
      gap: var(--space-10) var(--space-8);
      inline-size: 100%;
      min-inline-size: 0;
      padding: 0;
    }

    .logo-wall__list[aria-hidden='true'] {
      display: none;
    }

    @media (min-width: 768px) {
      .logo-wall__list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (min-width: 1280px) {
      .logo-wall__list {
        grid-template-columns: repeat(6, auto);
        justify-content: space-between;
        gap: 0;
      }
    }
  }
</style>
