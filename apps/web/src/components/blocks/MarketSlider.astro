---
import type { MarketSliderBlock } from '@repo/shared'
import Button from '@/components/ui/Button.astro'
import Picture from '@/components/ui/Picture.astro'
import ChevronLeft from '@/components/ui/icons/ChevronLeft.astro'

interface Props {
  block: MarketSliderBlock
}

const { block } = Astro.props

const headingId = 'market-slider-heading'

/**
 * The slider, and where its state lives.
 *
 * One radio per slide, `position: absolute` so it takes no grid cell, visually
 * hidden but focusable. The stylesheet turns "which radio is checked" into
 * `--active`, an integer on the body, and every moving part — the picture track,
 * the copy stack, the pair of step buttons — reads that one number.
 *
 * That buys three things a script would have to be written to do: the state
 * survives with no hydration, arrow keys move between slides because a radio
 * group already does that, and the browser announces position and count with no
 * ARIA at all.
 *
 * It costs one thing: the derivation is one static CSS rule per position, which
 * is why the schema caps `slides` at five. Adding a sixth means adding a rule —
 * see "Which slide is showing" in the stylesheet.
 *
 * The drag gesture at the bottom of this file is an ENHANCEMENT on top of that,
 * not a second source of truth: all it does is check a radio.
 */
const group = 'market-slider'
const slideId = (index: number) => `${group}-${index + 1}`

const count = block.slides.length
const prevOf = (index: number) => (index - 1 + count) % count
const nextOf = (index: number) => (index + 1) % count

/**
 * The block reserves its height from the FIRST slide, and every other slide is
 * cropped to it. A slider whose section grows a hundred pixels taller on slide 2
 * would push the rest of the page down mid-interaction — that is CLS with a
 * cause, not a rounding error.
 */
const lead = block.slides[0]!
const ratio = `${lead.image.width} / ${lead.image.height}`

/**
 * The copy, resolved per slide.
 *
 * A slide that states nothing of its own borrows the block's line — which is how
 * "one statement, several drawings of it" is said without repeating the sentence in
 * the JSON. Split into words here rather than in the browser: each word is its
 * own little mask, and the delay is its position in the sentence, so the line
 * reads as a wave crossing it instead of a block appearing.
 *
 * Words, not lines, and that is a deliberate limit: where a line breaks depends
 * on the measure, the font and the viewport, none of which are known at build
 * time. Measuring line boxes in the browser to split on them would cost a layout
 * pass on every resize to animate copy that has already been read once.
 */
const say = block.slides.map((slide) => ({
  words: (slide.description ?? block.description).split(/\s+/).filter(Boolean),
  cta: slide.cta ?? block.cta,
}))

/**
 * The illustrations are drawn at 640 px from 960 px square sources, so the output
 * ladder stops at the rendered size. `sizes` says 640 as soon as the layout stops
 * shrinking the picture, which is the same 680 px the fold below is written against.
 */
const SLIDE_WIDTHS = [320, 480, 640]
const SLIDE_SIZES = '(min-width: 680px) 640px, 100vw'
---

<section class="market" aria-labelledby={headingId} data-reveal-group>
  <div class="container-page">
    <div class="market__inner">
      <div class="market__head">
        <h2 class="market__heading text-title reveal-mask" id={headingId}>
          <span>{block.heading}</span>
        </h2>
      </div>

      <div class="market__body" style={`--market-ratio: ${ratio}`} data-market-body>
        {
          /*
            The state, and the whole keyboard story. A radio group is already the
            right control for "one of N": Tab reaches it once, arrow keys move
            through it, and the browser reports position and count without a word
            of ARIA. The visible buttons below are labels pointed at these.
          */
          block.slides.map((_, index) => (
            <input
              class="market__pick"
              type="radio"
              name={group}
              id={slideId(index)}
              checked={index === 0}
              aria-label={`Slide ${index + 1} of ${count}`}
            />
          ))
        }

        <div class="market__copy">
          {
            say.map(({ words, cta }) => (
              <div class="market__say" style={`--market-words: ${words.length}`}>
                <p class="market__note text-claim">
                  {words.map((word, index) => (
                    <>
                      <span class="market__word" style={`--market-word: ${index}`}>
                        <span>{word}</span>
                      </span>{' '}
                    </>
                  ))}
                </p>

                <div class="market__cta">
                  <Button link={cta} withArrow />
                </div>
              </div>
            ))
          }
        </div>

        <div class="market__stage" data-market-stage>
          <ul class="market__track" role="list">
            {
              block.slides.map((slide) => (
                <li class="market__slide">
                  {/*
                    The entrance, and it opens from the SIDE: the pane starts one
                    full width to the left of the figure's clip and the picture
                    inside counter-travels the same distance, so the illustration
                    stands still while the opening crosses it left to right.

                    `draggable={false}` is the other half of the gesture below —
                    without it the browser's own drag-and-drop wins the pointer
                    mid-swipe and leaves a ghost of the picture on the cursor.
                  */}
                  <figure class="market__figure">
                    <span
                      class="market__pane reveal-curtain"
                      style="--reveal-index: 1; --reveal-curtain-x: -100%; --reveal-curtain-y: 0%"
                    >
                      <span
                        class="market__hold reveal-curtain-hold"
                        style="--reveal-index: 1; --reveal-curtain-x: -100%; --reveal-curtain-y: 0%"
                      >
                        <Picture
                          image={slide.image}
                          widths={SLIDE_WIDTHS}
                          sizes={SLIDE_SIZES}
                          draggable={false}
                        />
                      </span>
                    </span>
                  </figure>
                </li>
              ))
            }
          </ul>
        </div>

        {
          /*
            One pair of steps per slide, because where "previous" and "next" point
            depends on where you are. The pairs are a track of their own, moved by
            the same `--active` — with no transition, so the swap is invisible and
            the two buttons simply keep pointing at the right neighbours.
          */
        }
        <div class="market__nav">
          <div class="market__nav-track">
            {
              block.slides.map((_, index) => (
                <div class="market__pair">
                  <label class="market__step" for={slideId(prevOf(index))}>
                    <ChevronLeft />
                    <span class="sr-only">Previous slide</span>
                  </label>

                  <label class="market__step market__step--next" for={slideId(nextOf(index))}>
                    <ChevronLeft />
                    <span class="sr-only">Next slide</span>
                  </label>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .market {
    background-color: var(--color-fg);
    color: var(--color-on-media);
    /* Everything in this section sits on Lime-Dark; the accent ring has to be
       the thing that is visible against it, not the thing that vanishes into it. */
    --color-focus: var(--color-on-media);
  }

  /*
   * The box. Its side borders are the section's only vertical rules and they run
   * the full height — heading band and body alike — so they are declared here and
   * nowhere else.
   */
  .market__inner {
    border-inline: 1px solid var(--market-rule);
  }

  /* ── Heading band ─────────────────────────────────────────────────────────── */
  .market__head {
    padding-block: var(--market-head-pad-block) var(--market-head-gap);
    padding-inline: var(--market-pad);
    border-block-end: 1px solid var(--market-rule);
  }

  .market__heading {
    margin: 0;
    color: var(--color-on-media);
  }

  /* ── Body ─────────────────────────────────────────────────────────────────
   * Three columns: copy, illustration, and the column the step buttons start in.
   * The picture is a fixed 640 and the two side columns take what is left, which
   * is what centres it in the grid without a single absolute position — and what
   * puts the buttons against its right edge for free.
   */
  .market__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--market-figure-size) minmax(0, 1fr);
  }

  /*
   * The state, parked out of the layout. `position: absolute` takes it out of the
   * grid flow entirely, so three radios do not claim three cells; 1 px rather
   * than `display: none` because a hidden input is not focusable, and the arrow
   * keys are the block's keyboard interface.
   */
  .market__pick {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  /* ── Copy ─────────────────────────────────────────────────────────────────
   * Every slide's copy, stacked in one cell and bottom-aligned to the picture's
   * foot. Stacked rather than tracked: the column is a third of the width the
   * pictures move across, so sliding it the same distance would either run at a
   * different speed or need its own number. It cross-fades, and the words of the
   * incoming line arrive one after another on top of the fade.
   */
  .market__copy {
    grid-row: 1;
    grid-column: 1;
    display: grid;
    align-self: end;
    padding-inline-start: var(--market-pad);
    padding-block-end: var(--market-pad);
  }

  .market__say {
    grid-area: 1 / 1;
    align-self: end;
    opacity: 0;
    /*
     * `visibility`, not just `opacity`: a transparent CTA is still a link in the
     * tab order, and a keyboard landing on a button nobody can see is the classic
     * carousel bug. Delayed by the fade so it goes out AFTER the copy has faded,
     * not at the first frame.
     */
    visibility: hidden;
    transition:
      opacity var(--duration-base) var(--ease-standard),
      visibility 0s linear var(--duration-base);
  }

  .market__note {
    max-inline-size: var(--market-copy-measure);
    margin: 0;
    color: var(--color-on-media);
  }

  /*
   * One word, one aperture.
   *
   * `clip-path`, not `overflow: hidden`, for the reason `.reveal-mask` gives in
   * global.css: with a tight line box the descenders fall outside it and
   * `overflow` slices them off. The negative insets extend the visible region
   * without touching layout.
   */
  .market__word {
    display: inline-block;
    clip-path: inset(-0.02em -0.05em -0.16em);
  }

  .market__word > span {
    display: inline-block;
    /*
     * The resting state is HIDDEN, and that is what makes the entrance repeatable:
     * the animation is switched on by name (`--market-line`, set only on the
     * active slide), and a property that goes from a name back to `none` restarts
     * from scratch the next time it is set. A transition cannot do that — it has
     * no way to replay itself when a slide comes back around.
     */
    transform: translate3d(0, var(--market-word-travel), 0);
    /*
     * Longhands, not the `animation` shorthand, and it is not a style preference:
     * `none` is a valid value for BOTH `animation-name` and `animation-fill-mode`,
     * so `animation: var(--market-line, none) 900ms <ease> both` parses with the
     * two swapped — the browser takes `both` as the NAME. Measured, not feared:
     * the computed `animation-name` came back as `both`.
     */
    animation-name: var(--market-line, none);
    animation-duration: var(--duration-reveal);
    animation-timing-function: var(--ease-out-expo);
    animation-fill-mode: both;
    animation-delay: calc(var(--market-word) * var(--market-word-step));
  }

  .market__cta {
    margin-block-start: var(--market-copy-gap);
    opacity: 0;
    /* Longhands for the same reason as the words above. */
    animation-name: var(--market-rise, none);
    animation-duration: var(--duration-reveal);
    animation-timing-function: var(--ease-out-expo);
    animation-fill-mode: both;
    /* After the last word, not with it. */
    animation-delay: calc((var(--market-words) + 1) * var(--market-word-step));
  }

  @keyframes market-word-in {
    from {
      transform: translate3d(0, var(--market-word-travel), 0);
    }
    to {
      transform: none;
    }
  }

  @keyframes market-cta-in {
    from {
      opacity: 0;
      transform: translate3d(0, 1.25rem, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /*
   * The section's own entrance holds these at their first frame until the
   * observer in BaseLayout marks the group. The global rule in global.css only
   * knows about the `.reveal-*` classes, and these two animations are switched by
   * name rather than by class — so the group's gate is repeated here for them.
   */
  :global(html.js) .market:not([data-inview]) .market__word > span,
  :global(html.js) .market:not([data-inview]) .market__cta {
    animation-play-state: paused;
  }

  /* ── Pictures ─────────────────────────────────────────────────────────────── */
  .market__stage {
    grid-row: 1;
    grid-column: 2;
    /* The aperture the track runs behind. */
    overflow: clip;
    /*
     * The gesture's contract with the browser. Horizontal pointer movement over
     * this box belongs to the slider; vertical movement stays with the page, so a
     * finger that starts on the illustration can still scroll past it. Without
     * this the browser waits to see which way the finger goes and the first ~100
     * ms of every swipe is lost.
     */
    touch-action: pan-y;
    cursor: grab;
    /* A drag that selects the copy next to it is a drag that looks broken. */
    user-select: none;
  }

  .market__stage.is-dragging {
    cursor: grabbing;
  }

  /*
   * A flex row that stays exactly one picture wide while its children overflow
   * it. That is what makes the translate below readable: 100% is one slide, so
   * `--active` maps onto it directly with no division by the slide count.
   *
   * `--drag` is the live offset of a finger mid-swipe, and it is added to the
   * same expression rather than given a transform of its own — one property, one
   * compositor layer, and the release simply drops the term.
   */
  .market__track {
    display: flex;
    inline-size: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translate3d(calc((var(--active, 1) - 1) * -100% + var(--drag, 0px)), 0, 0);
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }

  /* While the finger is down the track IS the finger — a transition here would
     make it lag behind by a quarter of a second. */
  .market__stage.is-dragging .market__track {
    transition: none;
  }

  .market__slide {
    flex: 0 0 100%;
  }

  .market__figure {
    margin: 0;
    /* Keeps the hold's overscan off the neighbouring slide. The entrance aperture
       is NOT here — see the pane below. */
    overflow: clip;
  }

  /*
   * The aperture is THIS box, not the figure's.
   *
   * The same trap `ServiceCards` and `TeamGrid` both fell into and both record:
   * with the clip one level up, the picture is in its final place from the first
   * frame (the hold counter-travels it there) and simply sits there, visible,
   * while an invisible empty pane slides past it. Clipping on the pane is what
   * makes the pane's own travelling box the opening — the picture shows only as
   * far as the box has reached, which is the unmask.
   */
  .market__pane {
    display: block;
    overflow: clip;
  }

  .market__hold {
    display: block;
  }

  .market__figure :global(img) {
    inline-size: 100%;
    block-size: auto;
    /* Every slide is cropped to the first one's box — see `ratio` in the script. */
    aspect-ratio: var(--market-ratio);
    object-fit: cover;
    /*
     * The non-standard half of "this picture is not a file you can drag out".
     * `draggable="false"` in the markup is the standard half and does the work
     * everywhere; this covers the WebKit path where a long-press still offers the
     * image, and neither of them needs a script to be true.
     */
    -webkit-user-drag: none;
    user-select: none;
  }

  /* ── Steps ────────────────────────────────────────────────────────────────── */
  .market__nav {
    grid-row: 1;
    grid-column: 3;
    /* Top of the body, hard against the picture's right edge: both are what the
       grid cell already is, so neither needs an offset. */
    align-self: start;
    justify-self: start;
    inline-size: calc(2 * var(--market-step-size) + var(--market-step-gap));
    overflow: clip;
  }

  /* No transition, deliberately: the pairs are identical, so an animated swap
     would only smear two things that look the same. */
  .market__nav-track {
    display: flex;
    inline-size: 100%;
    transform: translate3d(calc((var(--active, 1) - 1) * -100%), 0, 0);
  }

  .market__pair {
    flex: 0 0 100%;
    display: flex;
    gap: var(--market-step-gap);
  }

  .market__step {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--market-step-size);
    block-size: var(--market-step-size);
    background-color: var(--market-step-surface);
    color: var(--color-on-media);
    cursor: pointer;
    transition: background-color var(--duration-base) var(--ease-standard);
  }

  .market__step:hover {
    background-color: var(--market-step-surface-hover);
  }

  /* One glyph, mirrored. See ChevronLeft.astro. */
  .market__step--next {
    scale: -1 1;
  }

  /*
   * The focus ring belongs to the buttons even though the focus belongs to the
   * radio. A label cannot take focus and the radio is a pixel wide, so without
   * this a keyboard user driving the slider would see nothing at all move except
   * the pictures.
   */
  .market__pick:focus-visible ~ .market__nav {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* ── Which slide is showing ───────────────────────────────────────────────
   * The only place the checked radio becomes a number. One rule per position,
   * and the schema's `max(5)` is what keeps the list this length — a sixth slide
   * needs a sixth rule here, or it silently shows the fifth.
   */
  .market__body:has(.market__pick:nth-of-type(1):checked) {
    --active: 1;
  }
  .market__body:has(.market__pick:nth-of-type(2):checked) {
    --active: 2;
  }
  .market__body:has(.market__pick:nth-of-type(3):checked) {
    --active: 3;
  }
  .market__body:has(.market__pick:nth-of-type(4):checked) {
    --active: 4;
  }
  .market__body:has(.market__pick:nth-of-type(5):checked) {
    --active: 5;
  }

  /*
   * …and the only place a slide's copy is told it is on stage. Five selectors,
   * one declaration: the two animation NAMES, which is what replays the words
   * every time a slide comes back around.
   */
  .market__body:has(.market__pick:nth-of-type(1):checked) .market__say:nth-child(1),
  .market__body:has(.market__pick:nth-of-type(2):checked) .market__say:nth-child(2),
  .market__body:has(.market__pick:nth-of-type(3):checked) .market__say:nth-child(3),
  .market__body:has(.market__pick:nth-of-type(4):checked) .market__say:nth-child(4),
  .market__body:has(.market__pick:nth-of-type(5):checked) .market__say:nth-child(5) {
    opacity: 1;
    visibility: visible;
    /* Coming in, `visibility` must not wait for the fade it waits for on the way
       out — otherwise the incoming copy is invisible for its own first frames. */
    transition-delay: 0s;
    --market-line: market-word-in;
    --market-rise: market-cta-in;
  }

  /*
   * Reduced motion is handled globally — every animation lands on its end frame
   * at once — with one exception this block has to state itself: the track's
   * SLIDE is a transition, and collapsing it to 0.01 ms turns it into a cut,
   * which is exactly right. Nothing to add. The drag still tracks the finger,
   * because following a finger is not motion the page decided to make.
   */

  /* ── Fold ─────────────────────────────────────────────────────────────────
   * The design covers one width. Below the point where the two side columns stop
   * holding their contents — the copy's measure is 296 and its inset 20, so a
   * 1fr column narrower than ~316 starts squeezing it — the three columns become
   * one: the picture on top, the copy under it, the steps in the picture's own
   * top-right corner.
   *
   * 1240 = 640 of picture + 2 x 300 of column, i.e. the last width at which the
   * design's own arrangement still fits inside the page grid.
   */
  @media (max-width: 1239px) {
    .market__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .market__stage {
      grid-row: 1;
      grid-column: 1;
      inline-size: min(var(--market-figure-size), 100%);
      justify-self: center;
    }

    .market__copy {
      grid-row: 2;
      grid-column: 1;
      padding-block: var(--market-copy-gap) var(--market-pad);
    }

    /*
     * Over the illustration rather than beside it — there is no longer a column
     * to the right of it to sit in. It stays in the picture's top-right corner,
     * where it was, and the 8% ground it is drawn on reads on the artwork as well
     * as it does on Lime-Dark.
     */
    .market__nav {
      grid-row: 1;
      grid-column: 1;
      justify-self: end;
      margin-inline-end: max(0px, calc((100% - var(--market-figure-size)) / 2));
    }
  }
</style>

<script>
  /*
   * The swipe. ~0.6 KB, no bundle, no island.
   *
   * It is an enhancement over the radios and nothing more: the only thing it ever
   * does is check one of them, so the slider works identically with the script
   * removed, blocked or still downloading — the arrows are labels and need no JS
   * at all. Everything visual stays in the stylesheet; the script contributes one
   * number, `--drag`, and only while a finger is down.
   *
   * Pointer events, not touch events: one code path covers a finger, a stylus and
   * a mouse, and `setPointerCapture` keeps the gesture alive when the pointer
   * leaves the box mid-swipe — which on a small screen is most of them.
   */
  for (const stage of document.querySelectorAll<HTMLElement>('[data-market-stage]')) {
    const body = stage.closest<HTMLElement>('[data-market-body]')
    const track = stage.querySelector<HTMLElement>('ul')
    const picks = body ? [...body.querySelectorAll<HTMLInputElement>('input[type="radio"]')] : []
    if (!track || picks.length < 2) continue

    let pointer: number | null = null
    let start = 0
    let moved = 0

    const go = (step: number) => {
      const from = picks.findIndex((pick) => pick.checked)
      const to = (from + step + picks.length) % picks.length
      picks[to]!.checked = true
    }

    const release = (event: PointerEvent) => {
      if (event.pointerId !== pointer) return
      pointer = null
      stage.classList.remove('is-dragging')
      track.style.removeProperty('--drag')

      /*
       * A tenth of the picture, and never more than 60 px. A fraction alone asks
       * a phone for a swipe half the screen wide; a fixed number alone makes a
       * 640 px picture change on a twitch.
       */
      const threshold = Math.min(60, stage.clientWidth * 0.1)
      if (Math.abs(moved) > threshold) go(moved < 0 ? 1 : -1)
    }

    stage.addEventListener('pointerdown', (event) => {
      // Left button only; a right-click that starts a drag is a context menu.
      if (event.button !== 0) return
      pointer = event.pointerId
      start = event.clientX
      moved = 0
      /*
       * The class first, the capture second: capture is the call that can throw
       * (a pointer id the browser does not have an active pointer for), and if it
       * does, the track must still know it is being dragged.
       */
      stage.classList.add('is-dragging')
      stage.setPointerCapture(event.pointerId)
    })

    stage.addEventListener('pointermove', (event) => {
      if (event.pointerId !== pointer) return
      moved = event.clientX - start
      track.style.setProperty('--drag', `${moved}px`)
    })

    stage.addEventListener('pointerup', release)
    stage.addEventListener('pointercancel', release)

    /*
     * The last door out of the picture. `draggable="false"` and `-webkit-user-drag`
     * close it in the browsers that honour them; this closes it in the ones that
     * start a drag from the figure or a selection around it anyway.
     */
    stage.addEventListener('dragstart', (event) => event.preventDefault())
  }
</script>
