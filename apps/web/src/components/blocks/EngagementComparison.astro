---
import type { EngagementComparisonBlock } from '@repo/shared'
import Button from '@/components/ui/Button.astro'

interface Props {
  block: EngagementComparisonBlock
}

const { block } = Astro.props
const headingId = `engagement-${block.heading.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
const planOrder = (index: number) => 1 + index * 0.6
const rowOrder = (index: number) => 2.4 + index * 0.7
---

<section class="engagement" aria-labelledby={headingId} data-reveal-group>
  <div class="container-page engagement__comparison">
    <h2 id={headingId} class="engagement__heading text-title reveal-mask">
      <span>{block.heading}</span>
    </h2>

    <div class="engagement__table-wrap">
      <table class="engagement__table">
        <caption class="sr-only">Comparison of Retained and Ad-Hoc engagement models</caption>
        <thead>
          <tr>
            <th class="engagement__corner" scope="col"></th>
            {
              block.plans.map((plan, index) => (
                <th
                  class:list={['engagement__plan', 'reveal-fade', { 'engagement__plan--retained': index === 0 }]}
                  style={`--reveal-index: ${planOrder(index)}`}
                  scope="col"
                >
                  <span class="engagement__plan-content reveal" style={`--reveal-index: ${planOrder(index) + 0.35}`}>
                    {plan.icon === 'retained' ? (
                      <svg class="engagement__plan-icon" width="27" height="27" viewBox="0 0 27 27" fill="none" aria-hidden="true">
                      <path d="M3.375 11.7188C3.375 8.12145 3.375 6.32282 3.79971 5.71771C4.22441 5.11261 5.91561 4.53371 9.29802 3.37589L9.94243 3.15531C11.7056 2.55177 12.5872 2.25 13.5 2.25C14.4128 2.25 15.2944 2.55177 17.0576 3.15531L17.702 3.37589C21.0844 4.53371 22.7756 5.11261 23.2003 5.71771C23.625 6.32282 23.625 8.12145 23.625 11.7188V13.4903C23.625 19.8331 18.8561 22.9112 15.8641 24.2182C15.0525 24.5727 14.6467 24.75 13.5 24.75C12.3533 24.75 11.9475 24.5727 11.1359 24.2182C8.14383 22.9112 3.375 19.8331 3.375 13.4903V11.7188Z" stroke="currentColor" stroke-width="1.5" />
                      <path d="M10.6875 13.95L12.2947 15.75L16.3125 11.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    ) : (
                      <svg class="engagement__plan-icon" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                      <path d="M12.7905 1.39065L11.2392 9.54132L16.8592 9.56023L9.20934 20.6097L10.7607 11.6426L5.14106 11.6231L12.7905 1.39065ZM12.7916.015668C12.7544.015668 12.7173.0170215 12.6809.01975C12.4382.0393652 12.2773.12049 12.0865.248709C11.9791.320324 11.8823.406643 11.7988.505147C11.7738.534717 11.7501.56546 11.728.597272L4.02353 10.7939C3.71931 11.2109 3.67462 11.7613 3.90837 12.2212C4.14178 12.6811 4.61375 12.9726 5.13109 12.9764L9.10003 13.0053L7.85221 20.3571C7.73362 20.9889 8.07049 21.6186 8.66346 21.8723C8.83579 21.9464 9.02141 21.9845 9.20897 21.9844C9.64107 21.9844 9.99616 21.7823 10.2626 21.4172L17.9767 10.3677C18.2809 9.95069 18.3253 9.39966 18.0918 8.94041C17.8584 8.48047 17.3865 8.18895 16.8691 8.18519L12.9002 8.17831L14.1346 1.71409C14.1607 1.60826 14.1739 1.49964 14.1738 1.39063C14.1738.64675 13.5815.040375 12.8404.0163125C12.8239.015625 12.8077.015625 12.7916.015625V.015668Z" fill="currentColor" />
                      </svg>
                    )}
                    <span>{plan.name}</span>
                  </span>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            block.rows.map((row, rowIndex) => (
              <tr>
                <th class="engagement__row-heading" scope="row">
                  <span class="reveal" style={`--reveal-index: ${rowOrder(rowIndex)}`}>{row.heading}</span>
                </th>
                {row.values.map((value, index) => (
                  <td
                    class:list={['engagement__value', 'reveal-fade', { 'engagement__value--retained': index === 0 }]}
                    style={`--reveal-index: ${rowOrder(rowIndex) + index * 0.22}`}
                  >
                    <span class="engagement__value-content reveal" style={`--reveal-index: ${rowOrder(rowIndex) + 0.3 + index * 0.22}`}>
                      {value.status === 'included' && (
                        <svg class="engagement__status engagement__status--included" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 21C13.1819 21 14.3522 20.7672 15.4442 20.3149C16.5361 19.8626 17.5282 19.1997 18.364 18.364C19.1997 17.5282 19.8626 16.5361 20.3149 15.4442C20.7672 14.3522 21 13.1819 21 12C21 10.8181 20.7672 9.64778 20.3149 8.55585C19.8626 7.46392 19.1997 6.47177 18.364 5.63604C17.5282 4.80031 16.5361 4.13738 15.4442 3.68508C14.3522 3.23279 13.1819 3 12 3C9.61305 3 7.32387 3.94821 5.63604 5.63604C3.94821 7.32387 3 9.61305 3 12C3 14.3869 3.94821 16.6761 5.63604 18.364C7.32387 20.0518 9.61305 21 12 21ZM11.768 15.64L16.768 9.64L15.232 8.36L10.932 13.519L8.707 11.293L7.293 12.707L10.293 15.707L11.067 16.481L11.768 15.64Z" fill="currentColor" />
                        </svg>
                      )}
                      {value.status === 'excluded' && (
                        <svg class="engagement__status engagement__status--excluded" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M10 1.25C5.125 1.25 1.25 5.125 1.25 10C1.25 14.875 5.125 18.75 10 18.75C14.875 18.75 18.75 14.875 18.75 10C18.75 5.125 14.875 1.25 10 1.25ZM13.375 14.375L10 11L6.625 14.375L5.625 13.375L9 10L5.625 6.625L6.625 5.625L10 9L13.375 5.625L14.375 6.625L11 10L14.375 13.375L13.375 14.375Z" fill="currentColor" />
                        </svg>
                      )}
                      <span>{value.text}</span>
                    </span>
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="engagement__cta" data-reveal-group>
    <div class="container-page engagement__cta-inner">
      <div class="engagement__cta-copy">
        <h3 class="engagement__cta-heading reveal-mask">
          <span>{block.cta.heading}</span>
        </h3>
        <p class="engagement__cta-description reveal" style="--reveal-index: 1">{block.cta.description}</p>
      </div>
      <div class="engagement__cta-action reveal" style="--reveal-index: 2">
        <Button link={block.cta.link} withArrow />
      </div>
    </div>
  </div>
</section>

<style>
  .engagement {
    padding-top: var(--engagement-padding-top);
    background-color: var(--color-bg);
  }

  .engagement__heading {
    color: var(--color-fg);
  }

  .engagement__table-wrap {
    margin-top: var(--engagement-heading-gap);
  }

  .engagement__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: var(--engagement-column-gap) 0;
    table-layout: fixed;
  }

  .engagement__corner,
  .engagement__row-heading {
    width: var(--engagement-label-column);
  }

  .engagement__plan,
  .engagement__row-heading,
  .engagement__value {
    padding: var(--engagement-cell-padding-block) var(--engagement-cell-padding-inline);
    text-align: left;
    vertical-align: middle;
  }

  .engagement__plan {
    background-color: var(--color-bg-inverse);
    color: var(--color-fg-inverse);
    font-size: var(--text-tab);
    font-weight: var(--text-tab--font-weight);
    line-height: var(--text-tab--line-height);
  }

  .engagement__plan--retained {
    background-color: var(--color-green);
  }

  .engagement__plan-icon,
  .engagement__status {
    display: inline-block;
    width: var(--engagement-plan-icon-size);
    height: var(--engagement-plan-icon-size);
    margin-right: var(--engagement-icon-gap);
    vertical-align: middle;
  }

  .engagement__plan-content,
  .engagement__value-content {
    display: inline-flex;
    align-items: center;
  }

  .engagement__row-heading,
  .engagement__value {
    border-bottom: var(--engagement-rule-width) solid var(--color-rule-soft);
  }

  .engagement__row-heading {
    color: var(--color-fg);
    font-size: var(--text-tab);
    font-weight: var(--text-tab--font-weight);
    line-height: var(--text-tab--line-height);
  }

  .engagement__value {
    background-color: var(--engagement-adhoc-surface);
    color: var(--engagement-value-color);
    font-size: var(--text-table-value);
    font-weight: var(--text-table-value--font-weight);
    line-height: var(--text-table-value--line-height);
  }

  .engagement__value--retained {
    background-color: var(--engagement-retained-surface);
  }

  .engagement__status {
    margin-right: var(--engagement-status-gap);
  }

  .engagement__status--included {
    width: var(--engagement-check-icon-size);
    height: var(--engagement-check-icon-size);
    color: var(--color-green);
  }

  .engagement__status--excluded {
    width: var(--engagement-cross-icon-size);
    height: var(--engagement-cross-icon-size);
    color: var(--color-lime-dark);
  }

  .engagement__cta {
    margin-top: var(--engagement-cta-gap);
    padding-block: var(--engagement-cta-padding-block);
    background-color: var(--color-green);
    color: var(--color-fg-inverse);
  }

  .engagement__cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--engagement-cta-column-gap);
  }

  .engagement__cta-heading {
    font-size: var(--text-comparison-cta);
    font-weight: var(--text-comparison-cta--font-weight);
    line-height: var(--text-comparison-cta--line-height);
    letter-spacing: var(--text-comparison-cta--letter-spacing);
  }

  .engagement__cta-description {
    margin-top: var(--engagement-cta-copy-gap);
    font-size: var(--text-body);
    font-weight: var(--text-body--font-weight);
    line-height: var(--text-body--line-height);
  }

  .engagement__cta-action {
    --button-surface: var(--color-lime-dark);
    --button-surface-hover: var(--engagement-button-surface-hover);
    --button-fg: var(--color-white);
    flex: none;
  }

  @media (max-width: 47.9375rem) {
    .engagement__table,
    .engagement__table thead,
    .engagement__table tbody {
      display: block;
    }

    .engagement__table tr {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--engagement-column-gap);
    }

    .engagement__corner {
      display: none;
    }

    .engagement__plan,
    .engagement__row-heading,
    .engagement__value {
      width: auto;
      padding-inline: var(--engagement-mobile-cell-padding-inline);
    }

    .engagement__row-heading {
      grid-column: 1 / -1;
      border-bottom: 0;
      background-color: var(--color-bg);
    }

    .engagement__cta-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
