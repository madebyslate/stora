---
import type { TechnicalDepthTabsBlock } from '@repo/shared'
import Picture from '@/components/ui/Picture.astro'
import { getRetinaWidths } from '@/lib/images'
import LongArrowRight from '@/components/ui/icons/LongArrowRight.astro'

interface Props {
  block: TechnicalDepthTabsBlock
}

const { block } = Astro.props
const key = block.heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
const group = `technical-depth-tabs-${key}`
const headingId = `${group}-heading`
const optionId = (index: number) => `${group}-${index + 1}`
const headingLines = block.heading.split('\n')
---

<section class="technical" aria-labelledby={headingId} data-reveal-group>
  <div class="container-page">
    <h2 class="technical__heading text-title" id={headingId}>
      {
        headingLines.map((line, index) => (
          <span class="technical__heading-line reveal-mask" style={`--reveal-index: ${index}`}>
            <span>{line}</span>
          </span>
        ))
      }
    </h2>

    <div class="technical__body">
      <fieldset class="technical__switches">
        <legend class="sr-only">{block.heading.replace(/\n/g, ' ')}</legend>
        {
          block.items.map((item, index) => (
            <div class="technical__switch">
              <input
                class="technical__pick"
                type="radio"
                name={group}
                id={optionId(index)}
                data-panel={index + 1}
                checked={index === 0}
              />
              <label class="technical__tab" for={optionId(index)}>
                <span
                  class="technical__tab-main reveal-mask"
                  style={`--reveal-index: ${headingLines.length + index * 0.45}`}
                >
                  <span class="technical__tab-line">
                    <span class="technical__arrow">
                      <LongArrowRight />
                    </span>
                    <span class="technical__tab-label">
                      <span>{item.label}</span>
                    </span>
                  </span>
                </span>
              </label>
            </div>
          ))
        }
      </fieldset>

      <div class="technical__copy-stack" aria-live="polite">
        {
          block.items.map((item) => (
            <div class="technical__copy-panel">
              <h3 class="technical__copy-title text-panel-title">{item.title}</h3>
              <p class="technical__copy-description text-body">{item.description}</p>
            </div>
          ))
        }
      </div>

      <div class="technical__stage">
        {
          block.items.map((item) => (
            <figure class="technical__panel">
              <span class="technical__pane">
                <span class="technical__hold">
                  <Picture
                    image={item.image}
                    widths={getRetinaWidths([360, 480, 560], item.image.width)}
                    sizes="(max-width: 1199px) min(100vw, 560px), 560px"
                    draggable={false}
                  />
                </span>
              </span>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Geometry and choreography are shared with `HowWeDevelop`: the client asked
     for one switcher pattern across About Us, Dev-to-Sell, Brokerage and
     Dev-to-Hold. Only the media frame differs — the supplied photographs and
     BESS diagrams are square, so this block keeps its 560 square stage instead
     of the 974:564 landscape crop. */
  .technical {
    padding-block: var(--technical-padding-top) var(--technical-padding-bottom);
    background-color: var(--color-bg);
    color: var(--color-fg);
  }

  .technical__heading {
    color: var(--color-fg);
  }

  .technical__heading-line {
    width: fit-content;
  }

  .technical__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--technical-media-size));
    grid-template-rows: auto auto;
    column-gap: var(--technical-column-gap);
    row-gap: var(--technical-copy-media-gap);
    margin-top: var(--technical-heading-gap);
  }

  .technical__switches {
    grid-column: 1;
    grid-row: 1 / 3;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .technical__switch {
    position: relative;
    border-bottom: var(--technical-rule-width) solid var(--technical-rule-color);
  }

  .technical__pick {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .technical__tab {
    display: block;
    padding-block: var(--technical-tab-padding-block);
    color: var(--color-fg);
    font-size: var(--text-stage);
    font-weight: var(--text-stage--font-weight);
    line-height: var(--text-stage--line-height);
    letter-spacing: var(--text-stage--letter-spacing);
    cursor: pointer;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  /* The mask sits on the whole row, not on the label alone, so the arrow rides
     the same slide-up instead of being painted in place before the words
     arrive. Horizontal insets are widened because the active label steps aside
     by the arrow's width; only the vertical edge does the masking. */
  .technical__tab-main {
    display: block;
    min-width: 0;
    clip-path: inset(0 calc(-1 * var(--technical-tab-mask-bleed)) -0.16em);
  }

  .technical__tab-line {
    position: relative;
    display: block;
  }

  .technical__tab-label {
    display: block;
    width: fit-content;
    transform: none;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .technical__arrow {
    position: absolute;
    top: 50%;
    left: 0;
    display: block;
    width: var(--technical-arrow-width);
    height: var(--technical-arrow-height);
    opacity: 0;
    transform: translate3d(var(--technical-arrow-start), -50%, 0);
    transition:
      opacity var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-out-expo);
  }

  .technical__arrow :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .technical__pick:checked + .technical__tab {
    color: var(--technical-active-color);
  }

  .technical__pick:checked + .technical__tab .technical__tab-label {
    transform: translate3d(var(--technical-label-active-shift), 0, 0);
  }

  .technical__pick:checked + .technical__tab .technical__arrow {
    opacity: 1;
    transform: translate3d(0, -50%, 0);
  }

  .technical__pick:focus-visible + .technical__tab {
    outline: var(--technical-rule-width) solid var(--color-focus);
    outline-offset: var(--space-1);
  }

  @media (hover: hover) and (pointer: fine) {
    .technical__pick:not(:checked) + .technical__tab:hover {
      opacity: var(--technical-tab-hover-opacity);
    }
  }

  .technical__copy-stack {
    grid-column: 2;
    grid-row: 1;
  }

  .technical__copy-panel {
    display: none;
  }

  .technical__copy-title {
    color: var(--color-fg);
    opacity: 0;
    transform: translate3d(0, var(--technical-copy-title-shift), 0);
    animation-name: var(--technical-copy-title-animation, none);
    animation-duration: var(--duration-slow);
    animation-timing-function: var(--ease-out-expo);
    animation-fill-mode: both;
  }

  .technical__copy-description {
    max-width: var(--technical-copy-measure);
    margin-top: var(--technical-copy-gap);
    color: var(--technical-copy-color);
    opacity: 0;
    transform: translate3d(0, var(--technical-copy-description-shift), 0);
    animation-name: var(--technical-copy-description-animation, none);
    animation-duration: var(--duration-slow);
    animation-delay: var(--technical-copy-description-delay);
    animation-timing-function: var(--ease-out-expo);
    animation-fill-mode: both;
  }

  .technical__stage {
    position: relative;
    grid-column: 2;
    grid-row: 2;
    width: 100%;
    aspect-ratio: 1;
    overflow: clip;
  }

  .technical__panel,
  .technical__pane,
  .technical__hold {
    position: absolute;
    inset: 0;
    display: block;
    margin: 0;
  }

  .technical__panel {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-base) var(--ease-standard),
      visibility 0s linear var(--duration-base);
  }

  .technical__pane {
    overflow: clip;
    transform: translate3d(0, 100%, 0);
    animation-name: var(--technical-pane-animation, none);
    animation-duration: var(--duration-reveal);
    animation-timing-function: var(--ease-out-expo);
    animation-fill-mode: both;
  }

  .technical__hold {
    transform: translate3d(0, -100%, 0) scale(var(--technical-image-reveal-scale));
    animation-name: var(--technical-hold-animation, none);
    animation-duration: var(--duration-reveal);
    animation-timing-function: var(--ease-out-expo);
    animation-fill-mode: both;
  }

  .technical__hold :global(img) {
    position: absolute;
    inset: 0;
    max-width: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    -webkit-user-drag: none;
    user-select: none;
  }

  @keyframes technical-pane-in {
    from {
      transform: translate3d(0, 100%, 0);
    }
    to {
      transform: none;
    }
  }

  @keyframes technical-hold-in {
    from {
      transform: translate3d(0, -100%, 0) scale(var(--technical-image-reveal-scale));
    }
    to {
      transform: none;
    }
  }

  @keyframes technical-copy-title-in {
    from {
      opacity: 0;
      transform: translate3d(0, var(--technical-copy-title-shift), 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes technical-copy-description-in {
    from {
      opacity: 0;
      transform: translate3d(0, var(--technical-copy-description-shift), 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .technical__body:has(.technical__pick[data-panel='1']:checked) .technical__copy-panel:nth-child(1),
  .technical__body:has(.technical__pick[data-panel='2']:checked) .technical__copy-panel:nth-child(2),
  .technical__body:has(.technical__pick[data-panel='3']:checked) .technical__copy-panel:nth-child(3) {
    --technical-copy-title-animation: technical-copy-title-in;
    --technical-copy-description-animation: technical-copy-description-in;
    display: block;
  }

  .technical__body:has(.technical__pick[data-panel='1']:checked) .technical__panel:nth-child(1),
  .technical__body:has(.technical__pick[data-panel='2']:checked) .technical__panel:nth-child(2),
  .technical__body:has(.technical__pick[data-panel='3']:checked) .technical__panel:nth-child(3) {
    --technical-pane-animation: technical-pane-in;
    --technical-hold-animation: technical-hold-in;
    z-index: var(--z-content);
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  :global(html.js) .technical:not([data-inview]) .technical__pane,
  :global(html.js) .technical:not([data-inview]) .technical__hold,
  :global(html.js) .technical:not([data-inview]) .technical__copy-title,
  :global(html.js) .technical:not([data-inview]) .technical__copy-description {
    animation-play-state: paused;
  }

  /* The 30 px labels need roughly 360 px of column before they wrap, which the
     680 / 120 / 560 grid only delivers from 1200 px up — the previous 18 px
     labels survived down to 1024. */
  @media (max-width: 1199px) {
    .technical__body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      row-gap: 0;
    }

    .technical__switches,
    .technical__stage,
    .technical__copy-stack {
      grid-column: 1;
    }

    .technical__switches {
      grid-row: 1;
    }

    .technical__copy-stack {
      grid-row: 2;
      margin-top: var(--technical-mobile-copy-gap);
    }

    .technical__stage {
      grid-row: 3;
      width: min(100%, var(--technical-media-size));
      justify-self: center;
      margin-top: var(--technical-copy-media-gap);
    }
  }

  /* One column below 768 cannot spare the arrow's gutter; the rows are tapped
     rather than hovered here, so the arrow goes and the label keeps its full
     measure. Same call as `HowWeDevelop`. */
  @media (max-width: 767px) {
    .technical__arrow {
      display: none;
    }

    .technical__pick:checked + .technical__tab .technical__tab-label {
      transform: none;
    }
  }
</style>
