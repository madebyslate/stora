---
import type { TechnicalDepthTabsBlock } from '@repo/shared'
import Picture from '@/components/ui/Picture.astro'
import LongArrowRight from '@/components/ui/icons/LongArrowRight.astro'

interface Props {
  block: TechnicalDepthTabsBlock
}

const { block } = Astro.props
const key = block.heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
const group = `technical-depth-tabs-${key}`
const headingId = `${group}-heading`
const optionId = (index: number) => `${group}-${index + 1}`
const count = block.items.length.toString().padStart(2, '0')
const headingLines = block.heading.split('\n')
---

<section class="technical" aria-labelledby={headingId} data-reveal-group>
  <div class="container-page">
    <h2 class="technical__heading text-title" id={headingId}>
      {
        headingLines.map((line, index) => (
          <span class="technical__heading-line reveal-mask" style={`--reveal-index: ${index}`}>
            <span>{line}</span>
          </span>
        ))
      }
    </h2>

    <div class="technical__body">
      <fieldset class="technical__switches">
        <legend class="sr-only">{block.heading.replace(/\n/g, ' ')}</legend>
        {
          block.items.map((item, index) => (
            <div class="technical__switch">
              <input
                class="technical__pick"
                type="radio"
                name={group}
                id={optionId(index)}
                data-panel={index + 1}
                checked={index === 0}
              />
              <label class="technical__tab" for={optionId(index)}>
                <span class="technical__tab-main">
                  <span class="technical__arrow">
                    <LongArrowRight />
                  </span>
                  <span
                    class="technical__tab-label reveal-mask"
                    style={`--reveal-index: ${headingLines.length + 1 + index * 0.45}`}
                  >
                    <span>{item.label}</span>
                  </span>
                </span>
                <span
                  class="technical__counter reveal-mask"
                  style={`--reveal-index: ${headingLines.length + 1.2 + index * 0.45}`}
                >
                  <span>{String(index + 1).padStart(2, '0')}/{count}</span>
                </span>
              </label>
            </div>
          ))
        }
      </fieldset>

      <div class="technical__copy-stack" aria-live="polite">
        {
          block.items.map((item) => (
            <div class="technical__copy-panel">
              <h3 class="technical__copy-title text-heading">{item.title}</h3>
              <p class="technical__copy-description text-body">{item.description}</p>
            </div>
          ))
        }
      </div>

      <div class="technical__stage">
        {
          block.items.map((item) => (
            <figure class="technical__panel">
              <span class="technical__pane">
                <span class="technical__hold">
                  <Picture
                    image={item.image}
                    widths={[360, 480, 560]}
                    sizes="(max-width: 1023px) min(100vw, 560px), 560px"
                    draggable={false}
                  />
                </span>
              </span>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .technical {
    padding-block: var(--technical-padding-top) var(--technical-padding-bottom);
    background-color: var(--color-bg);
    color: var(--color-fg);
  }

  .technical__heading {
    color: var(--color-fg);
  }

  .technical__heading-line {
    width: fit-content;
  }

  .technical__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--technical-media-size));
    grid-template-rows: auto 1fr;
    column-gap: var(--technical-column-gap);
    min-height: var(--technical-media-size);
    margin-top: var(--technical-heading-gap);
  }

  .technical__switches {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .technical__switch {
    position: relative;
  }

  .technical__pick {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .technical__tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--technical-tab-padding-block);
    border-bottom: 1px solid currentColor;
    color: var(--color-fg);
    font-size: var(--text-tab);
    font-weight: var(--text-tab--font-weight);
    line-height: var(--text-tab--line-height);
    letter-spacing: var(--text-tab--letter-spacing);
    opacity: var(--technical-tab-rest-opacity);
    cursor: pointer;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  .technical__tab-main {
    position: relative;
    min-width: 0;
  }

  .technical__tab-label {
    display: inline-block;
    transform: none;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .technical__arrow {
    position: absolute;
    top: 50%;
    left: 0;
    display: block;
    width: var(--technical-arrow-width);
    height: var(--technical-arrow-height);
    opacity: 0;
    transform: translate3d(var(--technical-arrow-start), -50%, 0);
    transition:
      opacity var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-out-expo);
  }

  .technical__arrow :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .technical__counter {
    flex: none;
    margin-left: var(--space-4);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  .technical__pick:checked + .technical__tab {
    opacity: 1;
  }

  .technical__pick:checked + .technical__tab .technical__tab-label {
    transform: translate3d(var(--technical-label-active-shift), 0, 0);
  }

  .technical__pick:checked + .technical__tab .technical__arrow,
  .technical__pick:checked + .technical__tab .technical__counter {
    opacity: 1;
  }

  .technical__pick:checked + .technical__tab .technical__arrow {
    transform: translate3d(0, -50%, 0);
  }

  .technical__pick:focus-visible + .technical__tab {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .technical__pick:not(:checked) + .technical__tab:hover {
      opacity: var(--technical-tab-hover-opacity);
    }
  }

  .technical__copy-stack {
    position: relative;
    grid-column: 1;
    grid-row: 2;
    align-self: end;
    min-height: var(--technical-copy-window);
    max-width: var(--technical-copy-measure);
  }

  .technical__copy-panel {
    position: absolute;
    inset: auto 0 0;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, var(--technical-copy-shift), 0);
    transition:
      opacity var(--duration-base) var(--ease-standard),
      transform var(--duration-slow) var(--ease-out-expo),
      visibility 0s linear var(--duration-base);
  }

  .technical__copy-title {
    color: var(--color-fg);
  }

  .technical__copy-description {
    max-width: var(--technical-copy-measure);
    margin-top: var(--technical-copy-gap);
    color: var(--technical-copy-color);
  }

  .technical__stage {
    position: relative;
    grid-column: 2;
    grid-row: 1 / 3;
    width: min(100%, var(--technical-media-size));
    aspect-ratio: 1;
    justify-self: end;
    overflow: clip;
  }

  .technical__panel,
  .technical__pane,
  .technical__hold {
    position: absolute;
    inset: 0;
    display: block;
    margin: 0;
  }

  .technical__panel {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-base) var(--ease-standard),
      visibility 0s linear var(--duration-base);
  }

  .technical__pane {
    overflow: clip;
    transform: translate3d(0, 100%, 0);
    animation-name: var(--technical-pane-animation, none);
    animation-duration: var(--duration-reveal);
    animation-timing-function: var(--ease-out-expo);
    animation-fill-mode: both;
  }

  .technical__hold {
    transform: translate3d(0, -100%, 0) scale(var(--technical-image-reveal-scale));
    animation-name: var(--technical-hold-animation, none);
    animation-duration: var(--duration-reveal);
    animation-timing-function: var(--ease-out-expo);
    animation-fill-mode: both;
  }

  .technical__hold :global(img) {
    position: absolute;
    inset: 0;
    max-width: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    -webkit-user-drag: none;
    user-select: none;
  }

  @keyframes technical-pane-in {
    from {
      transform: translate3d(0, 100%, 0);
    }
    to {
      transform: none;
    }
  }

  @keyframes technical-hold-in {
    from {
      transform: translate3d(0, -100%, 0) scale(var(--technical-image-reveal-scale));
    }
    to {
      transform: none;
    }
  }

  .technical__body:has(.technical__pick[data-panel='1']:checked) .technical__copy-panel:nth-child(1),
  .technical__body:has(.technical__pick[data-panel='2']:checked) .technical__copy-panel:nth-child(2),
  .technical__body:has(.technical__pick[data-panel='3']:checked) .technical__copy-panel:nth-child(3) {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .technical__body:has(.technical__pick[data-panel='1']:checked) .technical__panel:nth-child(1),
  .technical__body:has(.technical__pick[data-panel='2']:checked) .technical__panel:nth-child(2),
  .technical__body:has(.technical__pick[data-panel='3']:checked) .technical__panel:nth-child(3) {
    --technical-pane-animation: technical-pane-in;
    --technical-hold-animation: technical-hold-in;
    z-index: var(--z-content);
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  :global(html.js) .technical:not([data-inview]) .technical__pane,
  :global(html.js) .technical:not([data-inview]) .technical__hold {
    animation-play-state: paused;
  }

  @media (max-width: 1023px) {
    .technical__body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      min-height: 0;
    }

    .technical__switches,
    .technical__stage,
    .technical__copy-stack {
      grid-column: 1;
    }

    .technical__switches {
      grid-row: 1;
    }

    .technical__stage {
      grid-row: 2;
      justify-self: center;
      margin-top: var(--technical-mobile-stage-gap);
    }

    .technical__copy-stack {
      grid-row: 3;
      width: 100%;
      margin-top: var(--technical-mobile-copy-gap);
    }
  }
</style>
