/**
 * Stora Energy wordmark, inlined.
 *
 * Inline rather than <img src="logo.svg"> for two reasons: it removes a render
 * blocking request from the critical path (the mark is the first thing painted in
 * the header), and it lets the fill follow `currentColor`, so the same file works
 * on media and on a light surface without a second asset.
 *
 * The artwork is 96 x 36 at its intended size; `width`/`height` are set so the box
 * is reserved before any CSS lands.
 */

interface Props {
  class?: string
}

const { class: className } = Astro.props
