---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getSite } from '@/lib/content'

const site = await getSite()

const seo = {
  title: 'Page not found — Stora Energy',
  description: 'There is nothing at this address.',
  noindex: true,
}
---

<BaseLayout seo={seo} path="/404/" site={site}>
  <div class="container-page not-found">
    <h1 class="text-display">Page not found</h1>
    <p class="not-found__body text-lead">The address is out of date, or has a typo in it.</p>
    <p class="not-found__back">
      <a href="/">Back to the home page</a>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-13) var(--space-14);
  }

  .not-found__body {
    margin-block-start: var(--space-5);
    color: var(--color-fg-muted);
  }

  .not-found__back {
    margin-block-start: var(--space-8);
  }

  .not-found__back a {
    color: inherit;
    text-underline-offset: 0.25em;
  }
</style>
